{
  "name": "Ditto Music",
  "verified": false,
  "note": "Rewritten 2026-11-13 from the live Release Builder (dashboard.dittomusic.com, signed in, test draft). Builder: Create Release dialog (Release Title → Get Started) → 1 Upload (audio, then artwork) → 2 Details (release info, AI, artists, tracklist with per-track Edit Metadata) → 3 Schedule → 4 Stores → 5 Review. A full run on a test draft reached 5 Review (2026-11-13); the map stops there, before 'Complete release', which the person presses. Set verified to true after the first real release goes through.",
  "start_url": "https://dashboard.dittomusic.com/music",
  "login_url": "https://dashboard.dittomusic.com/music",
  "login_patterns": ["login", "signin", "sign-in", "auth"],
  "steps": [
    { "name": "Create release", "action": "click", "target": { "role": "button", "name": "Create Release", "visible": true }, "settle": 1500 },
    { "name": "Release title", "action": "fill", "target": { "placeholder": "Release Title", "visible": true }, "value": "{{release.title}}" },
    { "name": "Get started", "action": "click", "target": { "role": "button", "name": "Get Started", "visible": true }, "settle": 4000 },

    { "name": "Audio files", "action": "upload", "target": { "css": "#AudioUploader" }, "files_from": "track_files", "settle": 4000, "timeout": 15000 },
    { "name": "License notice", "action": "click", "target": { "role": "button", "name": "I Understand", "visible": true }, "optional": true, "timeout": 20000 },
    { "name": "Next: artwork", "action": "click", "target": { "css": "a.next", "visible": true }, "settle": 2500 },
    { "name": "Artwork", "action": "upload", "target": { "css": "#ArtworkUploader" }, "files": "{{cover}}", "settle": 6000, "timeout": 15000 },
    { "name": "Next: details", "action": "click", "target": { "css": "a.next", "visible": true }, "settle": 3000 },

    { "for_each": "tracks", "steps": [
      { "name": "Track {{index}} review title", "action": "fill", "target": { "css": "input[name=confirmTitle]", "visible": true }, "value": "{{track.title}}", "optional": true, "timeout": 4000 },
      { "name": "Track {{index}} confirm title", "action": "click", "target": { "role": "button", "name": "Confirm Title", "visible": true }, "optional": true, "settle": 1500 }
    ] },
    { "name": "© Copyright holder", "action": "fill", "target": { "css": "input[name=copyrightHolder]", "visible": true }, "value": "{{release.copyright_holder}}" },
    { "name": "℗ Copyright holder", "action": "fill", "target": { "css": "input[name=productionHolder]", "visible": true }, "value": "{{release.copyright_holder}}" },
    { "name": "Primary genre", "action": "choose", "target": { "css": ".multiselect:has(#primaryGenre\\.id)" }, "value": "{{release.genre}}" },
    { "name": "Secondary genre", "action": "choose", "target": { "css": ".multiselect:has(#secondaryGenre\\.id)" }, "value": "{{release.subgenre}}", "optional": true },
    { "name": "Language", "action": "choose", "target": { "css": ".multiselect:has(#language\\.id)" }, "value": "{{release.language_label}}", "optional": true },
    { "name": "AI use: {{release.ai_use_text}}", "action": "check", "target": { "css": "input[name=ai-contribution][value={{release.ai_value}}]" }, "force": true, "value": "true" },
    { "name": "Primary artists", "action": "click", "target": { "role": "button", "name": "Add Artists", "visible": true }, "settle": 1500 },
    { "name": "Pick artist {{release.artist}}", "action": "click", "target": { "role": "button", "name": "{{release.artist}}", "visible": true } },
    { "name": "Confirm artists", "action": "click", "target": { "role": "button", "name": "Confirm", "visible": true }, "settle": 1500 },

    { "for_each": "tracks", "steps": [
      { "name": "Track {{index}} edit", "action": "click", "target": { "role": "button", "name": "Edit Metadata", "nth": "{{index}}" }, "unless": "input[name=mixVersion]", "settle": 1500 },
      { "name": "Track {{index}} review title (editor)", "action": "fill", "target": { "css": "input[name=confirmTitle]", "visible": true }, "value": "{{track.title}}", "optional": true, "timeout": 2500 },
      { "name": "Track {{index}} confirm title (editor)", "action": "click", "target": { "role": "button", "name": "Confirm Title", "visible": true }, "optional": true, "timeout": 2500, "settle": 1000 },
      { "name": "Track {{index}} title", "action": "fill", "target": { "css": "input[name=title][placeholder='Track Title']", "visible": true }, "value": "{{track.title}}", "optional": true },
      { "name": "Track {{index}} mix version", "action": "fill", "target": { "css": "input[name=mixVersion]", "visible": true }, "value": "{{track.version}}" },
      { "name": "Track {{index}} lyrics on", "action": "check", "target": { "css": "input[id^=LyricsInputToggle]" }, "force": true, "value": "{{track.has_lyrics}}", "optional": true },
      { "name": "Track {{index}} lyrics", "action": "fill", "target": { "css": "textarea[name=lyrics]", "visible": true }, "value": "{{track.lyrics}}", "optional": true },
      { "name": "Track {{index}} explicit", "action": "check", "target": { "css": "input[id^=ExplicitLyricsToggle]", "visible": true }, "value": "{{track.explicit_flag}}", "optional": true },
      { "name": "Track {{index}} composer", "action": "fill", "target": { "css": "input[name='contributors.0.name']", "visible": true }, "value": "{{track.credit_name}}" },
      { "name": "Track {{index}} composer AI", "action": "click", "target": { "css": ".dropdown.one-line.small:not(.full-width) > a.dropdown-toggle", "visible": true, "nth": 1 } },
      { "name": "Track {{index}} composer AI: {{track.ai.composer}}", "action": "click", "target": { "css": ".dropdown.open li >> text='{{track.ai.composer}}'", "visible": true } },
      { "name": "Track {{index}} songwriter", "action": "fill", "target": { "css": "input[name='contributors.1.name']", "visible": true }, "value": "{{track.credit_name}}" },
      { "name": "Track {{index}} songwriter AI", "action": "click", "target": { "css": ".dropdown.one-line.small:not(.full-width) > a.dropdown-toggle", "visible": true, "nth": 2 } },
      { "name": "Track {{index}} songwriter AI: {{track.ai.lyricist}}", "action": "click", "target": { "css": ".dropdown.open li >> text='{{track.ai.lyricist}}'", "visible": true } },
      { "name": "Track {{index}} songwriter role", "action": "choose", "target": { "css": ".multiselect:has(input[id='contributors[1]Roles'])", "visible": true }, "value": "Lyricist", "optional": true },
      { "name": "Track {{index}} producer", "action": "fill", "target": { "css": "input[name='contributors.2.name']", "visible": true }, "value": "{{track.credit_name}}" },
      { "name": "Track {{index}} producer AI", "action": "click", "target": { "css": ".dropdown.one-line.small:not(.full-width) > a.dropdown-toggle", "visible": true, "nth": 3 } },
      { "name": "Track {{index}} producer AI: {{track.ai.producer}}", "action": "click", "target": { "css": ".dropdown.open li >> text='{{track.ai.producer}}'", "visible": true } },
      { "name": "Track {{index}} producer role", "action": "choose", "target": { "css": ".multiselect:has(input[id='contributors[2]Roles'])", "visible": true }, "value": "Producer", "optional": true },
      { "name": "Track {{index}} performer", "action": "fill", "target": { "css": "input[name='contributors.3.name']", "visible": true }, "value": "{{track.credit_name}}" },
      { "name": "Track {{index}} performer AI", "action": "click", "target": { "css": ".dropdown.one-line.small:not(.full-width) > a.dropdown-toggle", "visible": true, "nth": 4 } },
      { "name": "Track {{index}} performer AI: {{track.ai.performer}}", "action": "click", "target": { "css": ".dropdown.open li >> text='{{track.ai.performer}}'", "visible": true } },
      { "name": "Track {{index}} performer role", "action": "choose", "target": { "css": ".multiselect:has(input[id='contributors[3]Roles'])", "visible": true }, "value": "Lead Vocals", "optional": true },
      { "name": "Track {{index}} save", "action": "click", "target": { "role": "button", "name": "Save Metadata", "visible": true }, "settle": 2500 }
    ] },
    { "name": "Next: schedule", "action": "click", "target": { "css": "a.next", "visible": true }, "settle": 4000 },

    { "name": "Release date: open calendar", "action": "click", "target": { "placeholder": "Select date", "visible": true }, "unless": ".dp__menu", "settle": 800 },
    { "name": "Release date: find month", "action": "click_until", "target": { "css": "[aria-label='Next month']", "visible": true }, "until": "#dp-{{release.release_date}}" },
    { "name": "Release date {{release.release_date}}", "action": "click", "target": { "css": "#dp-{{release.release_date}}", "visible": true }, "settle": 800 },
    { "name": "Standard Distro (included, no extra cost)", "action": "check", "target": { "css": "#StandardDistro" }, "force": true, "value": "true" },
    { "name": "Next: stores", "action": "click", "target": { "css": "a.next", "visible": true }, "settle": 4000 },

    { "name": "All standard stores", "action": "check", "target": { "css": "input#all[type=checkbox]" }, "force": true, "value": "true", "optional": true },
    { "name": "Next: review", "action": "click", "target": { "css": "a.next", "visible": true }, "settle": 4000 }
  ]
}
