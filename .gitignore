!/dual-version/VALIDATION-v1.1.1.json
!/dual-version/benchmark_styles.py
!/sing-studio-batch-preview/
/sing-studio-batch-preview/*
!/sing-studio-batch-preview/src/
!/sing-studio-batch-preview/scripts/
!/sing-studio-batch-preview/tests/
!/sing-studio-batch-preview/worker/
